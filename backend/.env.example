# Copy this file to ".env" for local testing.
# Wherever you actually deploy this backend (Render, Railway, a VPS,
# GoDaddy's Node.js Hosting, etc.), set these SAME variable names in
# that host's environment variable settings — most hosts don't read a
# .env file you upload; they have their own dashboard for this, same
# idea as Netlify's used to.

# From your HitPay Dashboard -> Settings -> Payment Gateway -> API Keys.
# Start with your SANDBOX key, not your Live one.
HITPAY_API_KEY=your-sandbox-api-key-here

# From the same place as the API key above — a separate secret used only
# to verify a webhook really came from HitPay. Not the same value as the
# API key.
HITPAY_SALT=your-salt-value-here

# "sandbox" or "production" — controls which HitPay API gets used.
# Always start with sandbox.
HITPAY_ENV=sandbox

# Your DEPLOYED STATIC SITE's exact URL (where index.html lives) — HitPay
# sends the shopper back here after they pay. NOT this backend's own URL.
SITE_URL=https://your-courtiva-site.example.com

# Your deployed static site's exact origin again, used here to tell this
# backend which domain is allowed to call it (CORS). Same value as
# SITE_URL above in almost every case.
ALLOWED_ORIGIN=https://your-courtiva-site.example.com

# Which port this server listens on. Most hosts set this for you
# automatically and ignore whatever you put here — check your host's
# docs. Fine to leave as-is for local testing.
PORT=3001
